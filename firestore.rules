rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64;
    }
    // A signed-in person may nudge a counter field (likes, views, remixes) by one.
    function onlyBumps(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields)
        && (!('likesCount' in request.resource.data.diff(resource.data).affectedKeys())
            || math.abs(request.resource.data.get('likesCount', 0) - resource.data.get('likesCount', 0)) <= 1)
        && (!('viewCount' in request.resource.data.diff(resource.data).affectedKeys())
            || math.abs(request.resource.data.get('viewCount', 0) - resource.data.get('viewCount', 0)) <= 1)
        && (!('remixCount' in request.resource.data.diff(resource.data).affectedKeys())
            || math.abs(request.resource.data.get('remixCount', 0) - resource.data.get('remixCount', 0)) <= 1);
    }

    match /comics/{comicId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(comicId)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() <= 80
        && (!('pagesJson' in request.resource.data) || request.resource.data.pagesJson.size() < 900000);
      allow update: if isSignedIn() && (
        (resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == request.auth.uid
          && (!('pagesJson' in request.resource.data) || request.resource.data.pagesJson.size() < 900000))
        || onlyBumps(['likesCount', 'viewCount']));
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;

      // Every page of a comic is its own document, so a comic can have many pages and chapters.
      match /pages/{pageId} {
        allow read: if true;
        allow create, update: if isSignedIn()
          && get(/databases/$(database)/documents/comics/$(comicId)).data.authorId == request.auth.uid
          && request.resource.data.img is string && request.resource.data.img.size() < 400000;
        allow delete: if isSignedIn()
          && get(/databases/$(database)/documents/comics/$(comicId)).data.authorId == request.auth.uid;
      }
    }

    match /collaborations/{collabId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /feed/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(postId)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() <= 80
        && request.resource.data.get('description', '').size() <= 400;
      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid
        || onlyBumps(['likesCount', 'remixCount']));
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // Reports from readers. Only you (the owner) can read them, in the Firebase console.
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId;

      match /saved_panels/{panelId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
      match /bookmarks/{comicId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}
